{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian.dev/schemas/eureka/structure-mapping-result.v1.schema.json",
  "title": "Structural Analogy Mapping Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "run_id", "scope_id", "capability_id", "capability_version", "status", "network", "maps", "verification_targets", "evidence_catalog", "warnings"],
  "properties": {
    "schema_version": { "const": "eureka.structure-mapping-result.v1" },
    "result_id": { "type": "string" },
    "run_id": { "type": "string" },
    "scope_id": { "type": "string" },
    "capability_id": { "const": "analogy.map_structure" },
    "capability_version": { "type": "string" },
    "status": { "enum": ["completed", "completed_empty", "partial"] },
    "network": { "const": "denied" },
    "maps": { "type": "array", "maxItems": 220, "items": { "type": "object" } },
    "verification_targets": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["inference_id", "hypothesis", "base_claim_ids", "target_context_claim_ids", "required_checks"],
        "properties": {
          "inference_id": { "type": "string" },
          "hypothesis": { "type": "string" },
          "base_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "target_context_claim_ids": { "type": "array", "items": { "type": "string" } },
          "required_checks": { "type": "array", "items": { "enum": ["find_support", "find_counterevidence", "check_novelty", "check_boundary"] } }
        }
      }
    },
    "evidence_catalog": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
