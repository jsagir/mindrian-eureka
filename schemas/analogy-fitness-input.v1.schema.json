{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.analogy-fitness-input.v1",
  "title": "Source/target analogy structure assessment",
  "type": "object",
  "required": ["target", "candidates"],
  "properties": {
    "scope_id": {"type": "string"},
    "target": {"$ref": "#/$defs/record"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "source_ref", "structure", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "description": {"type": "string", "maxLength": 20000},
        "structure": {
          "type": "object",
          "required": ["state_change", "action", "parts", "phenomenon", "input", "real_effect", "effect"],
          "properties": {
            "state_change": {"type": "string", "maxLength": 5000},
            "action": {"type": "string", "maxLength": 5000},
            "parts": {"type": "string", "maxLength": 5000},
            "phenomenon": {"type": "string", "maxLength": 5000},
            "input": {"type": "string", "maxLength": 5000},
            "real_effect": {"type": "string", "maxLength": 5000},
            "effect": {"type": "string", "maxLength": 5000}
          },
          "additionalProperties": false
        },
        "evidence_refs": {
          "type": "object",
          "required": ["state_change", "action", "parts", "phenomenon", "input", "real_effect", "effect"],
          "properties": {
            "state_change": {"type": "array", "items": {"type": "string"}},
            "action": {"type": "array", "items": {"type": "string"}},
            "parts": {"type": "array", "items": {"type": "string"}},
            "phenomenon": {"type": "array", "items": {"type": "string"}},
            "input": {"type": "array", "items": {"type": "string"}},
            "real_effect": {"type": "array", "items": {"type": "string"}},
            "effect": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
