{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian.dev/schemas/eureka/external-research-plan.v1.schema.json",
  "title": "Mindrian Eureka External Research Plan v1",
  "type": "object",
  "additionalProperties": false,
    "required": ["schema_version", "run_id", "stage", "scope_id", "queries"],
  "properties": {
    "schema_version": { "const": "eureka.external-research-plan.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "stage": { "enum": ["mechanism_discovery", "inference_verification"] },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "parent_result_id": { "type": ["string", "null"], "maxLength": 128 },
    "selected_inference_ids": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "queries": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["query_id", "intent", "query", "provider", "why", "source_refs", "query_hash"],
        "properties": {
          "query_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
          "intent": { "enum": ["find_mechanism", "find_support", "find_counterevidence", "check_novelty", "check_boundary"] },
          "query": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "query_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "SHA-256 of provider, exact query text, sorted include_domains/source_refs/inference_ids, and intent." },
          "provider": { "enum": ["openalex", "arxiv", "pubmed", "tavily"] },
          "include_domains": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 253 } },
          "why": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "uniqueItems": true },
          "inference_ids": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "uniqueItems": true }
        }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "grant_id": { "type": ["string", "null"], "maxLength": 256 },
        "approved_query_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "uniqueItems": true },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "approved_via": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "egress": { "const": "none; host approval and provider execution are still required" }
  }
}
