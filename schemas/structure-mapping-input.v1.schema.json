{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian.dev/schemas/eureka/structure-mapping-input.v1.schema.json",
  "title": "Structural Analogy Mapping Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "scope_id", "target", "target_evidence", "bases", "known_claims", "evidence_catalog"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "target": { "$ref": "#/$defs/description" },
    "target_evidence": { "$ref": "#/$defs/evidence_map" },
    "bases": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["base_id", "domain", "description", "evidence"],
        "properties": {
          "base_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "domain": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": { "$ref": "#/$defs/description" },
          "evidence": { "$ref": "#/$defs/evidence_map" }
        }
      }
    },
    "known_claims": { "type": "array", "maxItems": 500, "items": { "type": "string", "maxLength": 2000 } },
    "evidence_catalog": {
      "type": "array", "maxItems": 10000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "source_id", "source_ref", "locator", "quote_sha256", "origin"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "quote_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "origin": { "enum": ["room", "external"] },
          "provider": { "type": ["string", "null"], "maxLength": 64 },
          "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
          "query_hash": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
          "grant_id": { "type": ["string", "null"], "maxLength": 256 }
        }
      }
    },
    "rules": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["AN", "LS", "MA"] }, "default": ["AN", "MA"] },
    "max_maps_per_base": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 }
  },
  "$defs": {
    "description": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "entities", "expressions"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "entities": { "oneOf": [{ "type": "array", "items": { "type": "string", "maxLength": 256 } }, { "type": "object", "additionalProperties": { "type": ["string", "null"] } }] },
        "functions": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "uniqueItems": true },
        "commutative": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "uniqueItems": true },
        "constants": { "type": "array", "items": { "type": "string", "maxLength": 256 }, "uniqueItems": true },
        "expressions": {
          "type": "array", "minItems": 1, "maxItems": 2000,
          "items": { "type": "object", "additionalProperties": false, "required": ["functor", "args"], "properties": { "name": { "type": "string", "maxLength": 256 }, "functor": { "type": "string", "minLength": 1, "maxLength": 256 }, "args": { "type": "array", "maxItems": 20, "items": { "oneOf": [{ "type": "string", "maxLength": 256 }, { "type": "array" }] } } } }
        }
      }
    },
    "evidence_map": {
      "type": "object", "description": "Maps each expression name to one or more claim IDs in an approved research bundle or room snapshot.",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "uniqueItems": true }
    }
  }
}
