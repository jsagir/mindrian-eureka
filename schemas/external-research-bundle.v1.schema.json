{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian.dev/schemas/eureka/external-research-bundle.v1.schema.json",
  "title": "Mindrian Eureka Approved External Research Bundle v1",
  "description": "Evidence returned by the MindrianOS broker after it validates the user's approval. The Scout does not fetch or validate grants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "stage", "scope_id", "grant_id", "approved_query_hashes", "query_outcomes", "sources"],
  "properties": {
    "schema_version": { "const": "eureka.external-research-bundle.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "stage": { "enum": ["mechanism_discovery", "inference_verification"] },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "grant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "approved_query_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "uniqueItems": true },
    "query_outcomes": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["query_id", "query_hash", "status", "result_count"],
        "properties": {
          "query_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "query_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "status": { "enum": ["results", "empty_valid", "failed", "blocked"] },
          "result_count": { "type": "integer", "minimum": 0, "maximum": 100 },
          "failure_code": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    },
    "sources": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "query_id", "query_hash", "provider", "url", "title", "retrieved_at", "retrieval_status", "claims"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "query_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "query_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "provider": { "enum": ["openalex", "arxiv", "pubmed", "tavily", "tavily-extract", "webfetch"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
          "doi": { "type": ["string", "null"], "maxLength": 256 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "authors": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
          "published_at": { "type": ["string", "null"], "maxLength": 64 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "retrieval_status": { "enum": ["full_text", "abstract_only", "metadata_only", "snippet_only"] },
          "content_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
          "access_or_license_note": { "type": ["string", "null"], "maxLength": 1000 },
          "claims": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim_id", "text", "locator", "quote_sha256"],
              "properties": {
                "claim_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
                "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "quote_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
