{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian.dev/schemas/eureka/decision-sequence-fit-result.v1.schema.json",
  "title": "Exploratory Decision Sequence HMM Fit Result v1",
  "type": "object",
  "required": ["schema_version", "engine", "status", "sequence_count", "observation_count", "model", "warnings"],
  "properties": {
    "schema_version": { "const": "eureka.decision-sequence-fit-result.v1" },
    "engine": { "type": "object" },
    "status": { "const": "exploratory_unvalidated_fit" },
    "sequence_count": { "type": "integer", "minimum": 2 },
    "observation_count": { "type": "integer", "minimum": 32 },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "model": { "type": "object" },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
