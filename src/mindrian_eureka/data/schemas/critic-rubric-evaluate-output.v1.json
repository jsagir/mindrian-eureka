{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.critic-rubric-evaluate-output.v1",
  "type": "object",
  "required": ["schema_version", "capability_id", "capability_version", "status", "candidate_id", "source_node_id", "scope_id", "snapshot_id", "stage_a_status", "judge_model", "prompt_sha256", "rubric_pattern", "verdict", "reasoning_tag", "agreement", "judgments", "calls", "repeats", "confidence", "graph_write", "limitations", "runtime", "input_fingerprint"],
  "properties": {
    "schema_version": {"const": "eureka.critic-stage-b.v1"},
    "capability_id": {"const": "portfolio.evaluate_critic_rubric"},
    "capability_version": {"type": "string"},
    "status": {"enum": ["completed_rubric_triage", "rubric_disagreement"]},
    "candidate_id": {"type": "string"}, "source_node_id": {"type": "string"},
    "scope_id": {"type": "string"}, "snapshot_id": {"type": "string"},
    "stage_a_status": {"const": "passed_deterministic_gates"},
    "judge_model": {"type": "string"},
    "prompt_sha256": {"type": "object"},
    "rubric_pattern": {"type": "string", "pattern": "^[01x]{6}$"},
    "verdict": {"enum": ["transferable", "restatement", "pseudoscience", "general_shallow"]},
    "reasoning_tag": {"type": "string"}, "agreement": {"type": "object"},
    "judgments": {"type": "array"}, "calls": {"const": 2}, "repeats": {"const": 1},
    "confidence": {"const": "not_calibrated"}, "graph_write": {"const": "not_performed"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime": {"type": "string"}, "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
