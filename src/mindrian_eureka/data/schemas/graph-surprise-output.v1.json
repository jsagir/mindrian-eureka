{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-surprise-result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "status",
    "scope_id",
    "snapshot_id",
    "scores",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "eureka.graph-surprise-result.v1"
    },
    "capability_id": {
      "const": "graph.score_bayesian_surprise"
    },
    "status": {
      "const": "completed_analysis"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "prior",
          "posterior",
          "surprise_bits",
          "ignorance_risk"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
