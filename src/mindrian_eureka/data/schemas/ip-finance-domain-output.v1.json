{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.ip-finance-domain-result.v1",
  "title": "research.classify_ip_finance_domain_signals result",
  "type": "object",
  "required": ["schema_version", "capability_id", "capability_version", "scope_id", "snapshot_id", "input_fingerprint", "status", "segment_results", "warnings", "domain_rollup", "provenance", "limitations"],
  "properties": {
    "schema_version": { "const": "eureka.ip-finance-domain-result.v1" },
    "capability_id": { "const": "research.classify_ip_finance_domain_signals" },
    "capability_version": { "const": "0.1.0" },
    "scope_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "input_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "completed_lexical_domain_scan" },
    "segment_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_ref", "text_sha256", "classification", "classification_warnings"],
        "properties": {
          "id": { "type": "string" },
          "source_ref": { "type": "string" },
          "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "classification": { "type": "object" },
          "classification_warnings": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "segment_id", "source_ref", "tokens", "message"],
        "properties": {
          "code": { "const": "ambiguous_acronym_match" },
          "segment_id": { "type": "string" },
          "source_ref": { "type": "string" },
          "tokens": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "domain_rollup": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["source", "source_sha256", "method"],
      "properties": {
        "source": { "const": "LATEST GenesisDomainIdentifier_v3_IPFinance.js" },
        "source_sha256": { "const": "55ef917bb46da7065e668aba8e3df019e24259fc1b593a20a5a726597931319d" },
        "method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
