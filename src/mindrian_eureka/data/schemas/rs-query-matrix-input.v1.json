{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian-os.com/schemas/eureka/rs-query-matrix-input.v1.json",
  "title": "RS research query matrix request",
  "type": "object", "additionalProperties": false,
  "required": ["scope_id", "snapshot_id", "domain_analysis"],
  "properties": {
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "domain_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_domain", "concepts", "adjacent_domains"],
      "properties": {
        "primary_domain": {"type": "string", "minLength": 1, "maxLength": 500},
        "concepts": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "maxLength": 500}},
        "terminology": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 500}},
        "methods": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 500}},
        "breakthroughs": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 500}},
        "boundary_flag": {"type": "boolean"},
        "adjacent_domains": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "warning": {"type": "string", "maxLength": 500}
      }
    }
  }
}
