{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.text-differences-input.v1",
  "title": "analysis.compare_text_differences input",
  "type": "object",
  "properties": {
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "string",
            "minLength": 1
          },
          "b": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "legacy": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false
}
