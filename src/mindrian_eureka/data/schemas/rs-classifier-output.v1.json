{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian-os.com/schemas/eureka/rs-classifier-output.v1.json",
  "title": "RS innovation classification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "capability_version", "status", "scope_id", "snapshot_id", "classified_pair", "classification", "bridge_concept", "input_fingerprint", "run_config", "runtime", "limitations"],
  "properties": {
    "schema_version": {"const": "eureka.rs-classification.v1"},
    "capability_id": {"const": "research.classify_rs_pair"},
    "capability_version": {"const": "0.1.0"},
    "status": {"const": "classification_ready"},
    "scope_id": {"type": ["string", "null"]},
    "snapshot_id": {"type": ["string", "null"]},
    "classified_pair": {
      "type": "object", "additionalProperties": false,
      "required": ["query_concept", "doc_concept", "diff", "lsa", "bert", "passes", "classification", "bridge_concept"],
      "properties": {
        "query_concept": {"type": "string", "minLength": 1, "maxLength": 2000},
        "doc_concept": {"type": "string", "minLength": 1, "maxLength": 2000},
        "diff": {"type": "number"}, "lsa": {"type": "number"}, "bert": {"type": "number"},
        "passes": {"type": "boolean"},
        "classification": {"enum": ["structural_transfer", "semantic_implementation", "hybrid", "none"]},
        "bridge_concept": {"type": ["string", "null"], "maxLength": 100},
        "evidence": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false,
          "properties": {"source_id": {"type": "string", "maxLength": 500}, "url": {"type": "string", "maxLength": 4000}, "retrieved_at": {"type": "string", "maxLength": 100}, "side": {"enum": ["problem", "method", "unspecified"]}, "sentence": {"type": "string", "maxLength": 10000}}}},
        "second_signal": {"type": "object", "additionalProperties": false, "properties": {"confirmed": {"type": "boolean"}, "method": {"type": "string", "maxLength": 500}}},
        "novelty_check_status": {"enum": ["passed", "failed", "possible_prior_art", "not_run"]}
      }
    },
    "classification": {"enum": ["structural_transfer", "semantic_implementation", "hybrid", "none"]},
    "bridge_concept": {"type": ["string", "null"], "maxLength": 100},
    "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_config": {"type": "object", "additionalProperties": false, "properties": {"lsa_high": {"type": "number", "minimum": 0, "maximum": 1}, "bert_high": {"type": "number", "minimum": 0, "maximum": 1}}},
    "runtime": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
