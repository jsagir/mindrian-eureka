{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.hsi-baseline-whitespace-input.v1",
  "title": "portfolio.analyze_baseline_whitespace input",
  "type": "object",
  "required": ["embedding_model", "artifacts", "baseline_frameworks"],
  "properties": {
    "scope_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "embedding_model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifacts": {
      "type": "array", "minItems": 3, "maxItems": 2500,
      "items": {
        "type": "object", "required": ["id", "vector"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "title": { "type": "string", "maxLength": 500 },
          "section": { "type": "string", "maxLength": 500 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "text": { "type": "string", "maxLength": 20000 },
          "vector": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "number" } }
        },
        "additionalProperties": false
      }
    },
    "baseline_frameworks": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "required": ["id", "vector"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "name": { "type": "string", "maxLength": 500 },
          "label": { "type": "string", "maxLength": 500 },
          "description": { "type": "string", "maxLength": 10000 },
          "summary": { "type": "string", "maxLength": 5000 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "vector": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "number" } }
        },
        "additionalProperties": false
      }
    },
    "reducer_dimensions": { "type": "integer", "minimum": 1, "maximum": 64, "default": 15 },
    "kde_bandwidth": { "oneOf": [{ "enum": ["scott", "scott-scaled"] }, { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }] },
    "knn_k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 },
    "gap_percentile": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
  },
  "additionalProperties": false
}
