{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-traversal-result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "status",
    "scope_id",
    "snapshot_id",
    "paths",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "eureka.graph-traversal-result.v1"
    },
    "capability_id": {
      "const": "graph.rank_evidence_paths"
    },
    "status": {
      "const": "completed_analysis"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
