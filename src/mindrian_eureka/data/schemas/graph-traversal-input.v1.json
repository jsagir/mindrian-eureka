{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-traversal-input.v1",
  "title": "Host-retrieved evidence paths",
  "type": "object",
  "required": [
    "paths"
  ],
  "properties": {
    "paths": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "properties": {
          "hops": {
            "type": "integer",
            "minimum": 0
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "scope_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
