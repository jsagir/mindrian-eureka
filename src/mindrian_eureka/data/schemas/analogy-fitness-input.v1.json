{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.analogy-fitness-input.v1",
  "title": "analogy.assess_structural_fitness input",
  "type": "object",
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope_id": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/group"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "target",
    "candidates"
  ],
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "id",
        "source_ref",
        "structure",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "structure": {
          "type": "object",
          "properties": {
            "state_change": {
              "type": "string",
              "maxLength": 5000
            },
            "action": {
              "type": "string",
              "maxLength": 5000
            },
            "parts": {
              "type": "string",
              "maxLength": 5000
            },
            "phenomenon": {
              "type": "string",
              "maxLength": 5000
            },
            "input": {
              "type": "string",
              "maxLength": 5000
            },
            "real_effect": {
              "type": "string",
              "maxLength": 5000
            },
            "effect": {
              "type": "string",
              "maxLength": 5000
            }
          },
          "required": [
            "state_change",
            "action",
            "parts",
            "phenomenon",
            "input",
            "real_effect",
            "effect"
          ],
          "additionalProperties": false
        },
        "evidence_refs": {
          "type": "object",
          "properties": {
            "state_change": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "action": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "phenomenon": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "input": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "real_effect": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "effect": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "state_change",
            "action",
            "parts",
            "phenomenon",
            "input",
            "real_effect",
            "effect"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
