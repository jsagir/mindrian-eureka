{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.pitch-diagnostics-input.v1",
  "type": "object",
  "required": [
    "pitch",
    "proposal",
    "claims"
  ],
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "pitch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "comparisons": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "a",
          "b"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "proposal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "falsifier": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "evidence_quote": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
