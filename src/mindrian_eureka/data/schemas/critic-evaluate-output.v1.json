{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.critic-evaluate-output.v1",
  "type": "object",
  "required": ["schema_version", "capability_id", "capability_version", "stage", "status", "pass", "route", "tag", "features", "host_context", "graph_write", "limitations", "runtime", "input_fingerprint", "source_refs"],
  "properties": {
    "schema_version": {"const": "eureka.critic-stage-a.v1"},
    "capability_id": {"const": "portfolio.inspect_candidate_grounding"},
    "capability_version": {"type": "string"},
    "stage": {"const": "A"},
    "status": {"enum": ["passed_deterministic_gates", "gate_failed", "degraded"]},
    "pass": {"type": "boolean"},
    "route": {"type": ["string", "null"]},
    "tag": {"type": ["string", "null"]},
    "features": {"type": "object"},
    "host_context": {"type": "object"},
    "next_step": {"type": ["string", "null"]},
    "graph_write": {"const": "not_performed"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime": {"type": "string"},
    "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
