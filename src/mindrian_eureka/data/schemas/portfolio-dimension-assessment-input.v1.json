{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.portfolio-dimension-assessment-input.v1",
  "title": "portfolio.assess_candidate_dimensions input",
  "type": "object",
  "properties": {
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "items": {
      "type": "array", "minItems": 2, "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "primary_tier": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "pair_count": { "type": "number", "minimum": 0 },
          "degree": { "type": "number", "minimum": 0 },
          "source_refs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
        },
        "required": ["id", "primary_tier", "pair_count", "degree", "source_refs"],
        "additionalProperties": false
      }
    },
    "pair": {
      "type": "object",
      "properties": {
        "a_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "b_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rs_source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "rs": {
          "type": "object",
          "properties": {
            "direction": { "enum": ["structural_transfer", "semantic_implementation", "none"] },
            "abs_diff": { "type": "number", "minimum": 0, "maximum": 1 },
            "passes": { "type": "boolean" }
          },
          "required": ["direction", "abs_diff", "passes"],
          "additionalProperties": false
        }
      },
      "required": ["a_id", "b_id", "rs_source_ref", "rs"],
      "additionalProperties": false
    },
    "criteria_matrix": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "array", "minItems": 3, "maxItems": 3,
        "items": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "required": ["scope_id", "snapshot_id", "items", "pair", "criteria_matrix"],
  "additionalProperties": false
}
