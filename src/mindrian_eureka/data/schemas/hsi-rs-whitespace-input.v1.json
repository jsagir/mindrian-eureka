{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.hsi-rs-whitespace-input.v1",
  "title": "portfolio.discover_rs_whitespace input",
  "type": "object",
  "required": ["embedding_model", "artifacts", "baseline_frameworks", "reverse_salients"],
  "properties": {
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "embedding_model": {"type": "string", "minLength": 1, "maxLength": 200},
    "signal_method": {"enum": ["percentile", "fixed"], "default": "percentile"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 2500, "items": {
      "type": "object", "required": ["id", "section", "vector"], "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "section": {"type": "string", "minLength": 1, "maxLength": 500},
        "title": {"type": "string", "maxLength": 500},
        "text": {"type": "string", "maxLength": 20000},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "vector": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number"}}
      }, "additionalProperties": false
    }},
    "baseline_frameworks": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
      "type": "object", "required": ["id", "vector"], "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "name": {"type": "string", "maxLength": 500},
        "label": {"type": "string", "maxLength": 500},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "vector": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number"}}
      }, "additionalProperties": false
    }},
    "reverse_salients": {"type": "array", "maxItems": 500, "items": {
      "type": "object", "required": ["source_section", "target_section"], "properties": {
        "id": {"type": "string", "maxLength": 512},
        "opportunity_id": {"type": "string", "maxLength": 512},
        "source_section": {"type": "string", "maxLength": 500},
        "target_section": {"type": "string", "maxLength": 500},
        "differential_score": {"type": "number"},
        "score": {"type": "number"},
        "source_ref": {"type": "string", "maxLength": 2048}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
