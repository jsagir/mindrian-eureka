{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian-os.com/schemas/eureka/rs-thesis-input.v1.json",
  "title": "RS thesis generation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classified_pair"
  ],
  "properties": {
    "scope_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "classified_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_concept",
        "doc_concept",
        "classification"
      ],
      "properties": {
        "query_concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "doc_concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "classification": {
          "enum": [
            "structural_transfer",
            "semantic_implementation",
            "hybrid"
          ]
        },
        "bridge_concept": {
          "type": "string",
          "maxLength": 1000
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "maxLength": 4000
              },
              "retrieved_at": {
                "type": "string",
                "maxLength": 100
              },
              "side": {
                "enum": [
                  "problem",
                  "method",
                  "unspecified"
                ]
              },
              "sentence": {
                "type": "string",
                "maxLength": 10000
              }
            }
          }
        },
        "second_signal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confirmed": {
              "type": "boolean"
            },
            "method": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "novelty_check_status": {
          "enum": [
            "passed",
            "failed",
            "possible_prior_art",
            "not_run"
          ]
        },
        "diff": {
          "type": "number"
        },
        "lsa": {
          "type": "number"
        },
        "bert": {
          "type": "number"
        },
        "passes": {
          "type": "boolean"
        }
      }
    },
    "breakthrough": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "breakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feasibility": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "market": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "magnitude": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "advantage": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "impact": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "dominant_dimension": {
          "enum": [
            "feasibility",
            "market",
            "magnitude",
            "advantage",
            "impact"
          ]
        },
        "magnitude_mode": {
          "const": "percentile"
        },
        "diff_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
