{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.hsi-external-whitespace-input.v1",
  "title": "portfolio.analyze_external_whitespace input",
  "type": "object",
  "required": ["embedding_model", "research_grant_id", "retrieved_at", "artifacts", "external_papers"],
  "properties": {
    "scope_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "embedding_model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "research_grant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retrieved_at": { "type": "string", "minLength": 1, "maxLength": 100 },
    "artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2500,
      "items": {
        "type": "object", "required": ["id", "vector"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "title": { "type": "string", "maxLength": 500 },
          "section": { "type": "string", "maxLength": 500 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "vector": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "number" } }
        },
        "additionalProperties": false
      }
    },
    "external_papers": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object", "required": ["id", "title", "abstract", "source_ref", "vector"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "title": { "type": "string", "maxLength": 1000 },
          "abstract": { "type": "string", "minLength": 50, "maxLength": 50000 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "year": { "type": ["integer", "null"], "minimum": 0, "maximum": 3000 },
          "fields_of_study": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } },
          "vector": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "number" } }
        },
        "additionalProperties": false
      }
    },
    "known_gaps": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "required": ["id", "framework_name", "nearest_artifact_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "zone_id": { "type": "string", "maxLength": 512 },
          "framework_name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "nearest_artifact_ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "selection": { "enum": ["percentile", "legacy"], "default": "percentile" },
    "zone_percentile": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
    "gap_fill_percentile": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
    "cross_domain_percentile": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
    "top_n_per_gap": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
  },
  "additionalProperties": false
}
