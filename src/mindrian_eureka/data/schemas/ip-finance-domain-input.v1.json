{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.ip-finance-domain-input.v1",
  "title": "research.classify_ip_finance_domain_signals input",
  "type": "object",
  "properties": {
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 2500,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        },
        "required": ["id", "source_ref", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["scope_id", "snapshot_id", "segments"],
  "additionalProperties": false
}
