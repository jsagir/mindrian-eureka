{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-sme-bridge-result.v1",
  "title": "Graph neighborhood structural analogy result",
  "type": "object",
  "required": ["schema_version", "capability_id", "capability_version", "status", "scope_id", "snapshot_id", "input_fingerprint", "base_node_id", "target_node_id", "mapping", "limitations"],
  "properties": {
    "schema_version": {"const": "eureka.graph-sme-bridge-result.v1"},
    "capability_id": {"const": "graph.map_neighbourhoods"},
    "capability_version": {"const": "0.1.0"},
    "status": {"const": "completed_analysis"},
    "scope_id": {"type": ["string", "null"]},
    "snapshot_id": {"type": ["string", "null"]},
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base_node_id": {"type": "string"},
    "target_node_id": {"type": "string"},
    "mapping": {"type": "object", "required": ["matches", "truncated", "match_count", "base_neighborhood_size", "target_neighborhood_size", "rules", "hops", "attribute", "limitations"], "properties": {"matches": {"type": "array", "maxItems": 3}, "truncated": {"type": "boolean"}, "match_count": {"type": "integer"}, "base_neighborhood_size": {"type": "integer"}, "target_neighborhood_size": {"type": "integer"}, "rules": {"enum": ["AN", "LS", "MA"]}, "hops": {"type": "integer"}, "attribute": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
