{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-surprise-input.v1",
  "title": "Bayesian surprise records supplied by the host",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "prior",
          "posterior"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "claim": {
            "type": "string",
            "maxLength": 20000
          },
          "prior": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "posterior": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "scope_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
