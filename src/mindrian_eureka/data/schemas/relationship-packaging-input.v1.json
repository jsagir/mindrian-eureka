{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.relationship-packaging-input.v1",
  "title": "graph.package_relationship_proposals input",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 25000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "evidence_quote": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "maxItems": 50000
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "source_id",
          "target_id",
          "relation",
          "rationale",
          "evidence_ids"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 50000
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "nodes",
    "relationships"
  ],
  "additionalProperties": false
}
