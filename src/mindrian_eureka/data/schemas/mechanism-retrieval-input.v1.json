{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.mechanism-retrieval-input.v1",
  "title": "analogy.retrieve_mechanism_candidates input",
  "type": "object",
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "corpus_id": {
      "type": "string"
    },
    "scope_id": {
      "type": "string"
    },
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "source_excerpt": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "domain",
          "mechanism"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 20000
    }
  },
  "required": [
    "problem",
    "mechanisms"
  ],
  "additionalProperties": false
}
