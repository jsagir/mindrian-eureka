{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.critic-evaluate-input.v1",
  "type": "object",
  "required": ["candidate_id", "source_node_id", "scope_id", "snapshot_id", "candidate", "embedding", "nearest_neighbors"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_node_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate": {
      "type": "object",
      "required": ["text", "mechanismText"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "mechanismText": {"type": "string", "minLength": 1, "maxLength": 20000},
        "sourceDomainTag": {"type": "string", "maxLength": 100},
        "targetDomainTag": {"type": "string", "maxLength": 100},
        "differential": {"type": "number"}
      },
      "additionalProperties": true
    },
    "embedding": {
      "type": "object",
      "required": ["model", "vectors", "text_sha256"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "vectors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "number"}}},
        "text_sha256": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      },
      "additionalProperties": false
    },
    "nearest_neighbors": {"type": "array", "maxItems": 1000, "items": {"type": "object", "required": ["node_id", "similarity"], "properties": {"node_id": {"type": "string", "minLength": 1, "maxLength": 256}, "similarity": {"type": "number", "minimum": -1, "maximum": 1}}, "additionalProperties": true}},
    "source_refs": {"type": "array", "items": {"type": "string", "maxLength": 2048}},
    "sourced_quantities": {"type": "boolean"}
  },
  "additionalProperties": false
}
