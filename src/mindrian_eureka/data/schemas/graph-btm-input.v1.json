{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-btm-input.v1",
  "type": "object",
  "required": [
    "texts_a",
    "texts_b"
  ],
  "properties": {
    "texts_a": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200000
      }
    },
    "texts_b": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200000
      }
    },
    "k": {
      "type": "integer",
      "minimum": 1,
      "default": 6
    },
    "tau": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.18
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "integer"
      }
    },
    "scope_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
