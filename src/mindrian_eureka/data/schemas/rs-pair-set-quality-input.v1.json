{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrian-os.com/schemas/eureka/rs-pair-set-quality-input.v1.json",
  "title": "RS pair-set quality request",
  "type": "object",
  "additionalProperties": false,
  "required": ["scored_pairs"],
  "properties": {
    "scope_id": {"type": ["string", "null"], "maxLength": 200},
    "snapshot_id": {"type": ["string", "null"], "maxLength": 200},
    "scored_pairs": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "lsa", "bert"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1, "maxLength": 500},
          "lsa": {"type": "number"},
          "bert": {"type": "number"},
          "query_node_id": {"type": "string", "minLength": 1, "maxLength": 500},
          "doc_node_id": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
        }
      }
    }
  }
}
