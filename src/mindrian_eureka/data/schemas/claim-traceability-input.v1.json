{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.claim-traceability-input.v1",
  "title": "analysis.audit_claim_traceability input",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "proposal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "counterevidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "falsifier": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 500
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "evidence_quote": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "proposal",
    "claims"
  ],
  "additionalProperties": false
}
