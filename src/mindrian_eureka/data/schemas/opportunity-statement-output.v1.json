{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.opportunity-statement-output.v1",
  "title": "opportunity.prepare_statement result",
  "type": "object",
  "required": ["schema_version", "capability_id", "capability_version", "status", "scope_id", "snapshot_id", "input_fingerprint", "run_config", "draft", "limitations"],
  "properties": {
    "schema_version": { "const": "eureka.opportunity-statement-draft.v1" },
    "capability_id": { "const": "opportunity.prepare_statement" },
    "capability_version": { "type": "string" },
    "status": { "const": "draft_pending_host_review" },
    "scope_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "input_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "run_config": { "type": "object" },
    "draft": {
      "type": "object",
      "required": ["text", "fields", "critic", "banked", "weak_dimensions", "node_source_refs", "shared_problem_source_refs", "priority_signal_source_ref", "rank_source_ref"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "fields": {
          "type": "object",
          "required": ["tech_a", "unmet_need_a", "tech_b", "unmet_need_b", "novel_application", "gap", "audience", "risks", "next_steps", "potential_tier", "score_label", "composite"],
          "properties": {
            "tech_a": { "type": "string" }, "unmet_need_a": { "type": "string" },
            "tech_b": { "type": "string" }, "unmet_need_b": { "type": "string" },
            "novel_application": { "type": "string" }, "gap": { "type": "string" },
            "audience": { "type": "string" }, "risks": { "type": "string" },
            "next_steps": { "type": "string" }, "potential_tier": { "type": "string" },
            "score_label": { "type": "string" }, "composite": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "critic": { "const": "pending" },
        "banked": { "const": false },
        "weak_dimensions": { "type": "object", "additionalProperties": { "type": "array", "items": { "enum": ["strategic_fit", "validated_demand", "tech_econ_feasibility"] } } },
        "node_source_refs": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "shared_problem_source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "priority_signal_source_ref": { "type": "string" },
        "rank_source_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
