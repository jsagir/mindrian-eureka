{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.hsi-whitespace-interpretation-input.v1",
  "title": "portfolio.interpret_whitespace input",
  "type": "object",
  "required": ["gaps", "problem_type_edges", "umap_2d"],
  "properties": {
    "scope_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "gaps": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "required": ["id", "brain_framework", "nearest_room_artifacts"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 512},
          "brain_framework_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "brain_framework": {"type": "string", "maxLength": 500},
          "gap_percentile": {"type": "number", "minimum": 0, "maximum": 1},
          "density_score": {"type": "number"},
          "zone_id": {"type": "string", "maxLength": 512},
          "nearest_room_artifacts": {
            "type": "array", "maxItems": 100,
            "items": {"oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 512},
              {"type": "object", "anyOf": [{"required": ["id"]}, {"required": ["artifact_id"]}], "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 512},
                "artifact_id": {"type": "string", "minLength": 1, "maxLength": 512},
                "title": {"type": "string", "maxLength": 500},
                "section": {"type": "string", "maxLength": 500}
              }, "additionalProperties": false}
            ]}
          }
        },
        "additionalProperties": false
      }
    },
    "problem_type_edges": {
      "type": "array", "maxItems": 5000,
      "items": {"type": "object", "required": ["framework", "problem_type"], "properties": {
        "framework_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "framework": {"type": "string", "minLength": 1, "maxLength": 500},
        "problem_type": {"enum": ["Un-Defined", "Ill-Defined", "Well-Defined", "Wicked"]},
        "effectiveness": {"type": "number", "minimum": 0, "maximum": 1}
      }, "additionalProperties": false}
    },
    "feeds_into_edges": {
      "type": "array", "maxItems": 5000,
      "items": {"type": "object", "required": ["source", "target"], "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "source": {"type": "string", "minLength": 1, "maxLength": 500},
        "target": {"type": "string", "minLength": 1, "maxLength": 500},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "transform": {"type": "string", "maxLength": 1000}
      }, "additionalProperties": false}
    },
    "umap_2d": {"type": "object", "properties": {
      "room_artifacts": {"type": "array", "maxItems": 2500, "items": {"type": "object", "properties": {
        "id": {"type": ["string", "integer", "null"]}, "title": {"type": ["string", "null"], "maxLength": 500},
        "x": {"type": "number"}, "y": {"type": "number"}, "cluster": {"type": ["string", "integer", "null"]}
      }, "required": ["x", "y"], "additionalProperties": false}},
      "room": {"type": "array", "maxItems": 2500, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
      "labels_room": {"type": "array", "maxItems": 2500, "items": {"type": ["string", "integer", "null"]}}
    }, "additionalProperties": false},
    "spread_mode": {"enum": ["percentile", "fixed"], "default": "percentile"},
    "spread_percentile": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
    "offline_validate": {"type": "boolean", "default": false},
    "hypothesis_top": {"type": "integer", "minimum": 0, "maximum": 50, "default": 3}
  },
  "additionalProperties": false
}
