{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.opportunity-plan-input.v1",
  "title": "discovery.plan_opportunity_scout input",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 50
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "objective",
    "capability_ids"
  ],
  "additionalProperties": false
}
