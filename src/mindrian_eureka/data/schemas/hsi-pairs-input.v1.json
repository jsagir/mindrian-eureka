{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.hsi-input.v1",
  "title": "portfolio.find_hybrid_similarity_pairs input",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "corpus": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": true
      },
      "minItems": 2,
      "maxItems": 3000
    },
    "dense_vectors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 1,
        "maxItems": 20000
      }
    },
    "lexical": {
      "enum": [
        "hybrid",
        "lsa",
        "bm25"
      ]
    },
    "ranking": {
      "enum": [
        "percentile",
        "legacy"
      ]
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "min_percentile": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "artifacts"
  ],
  "additionalProperties": false
}
