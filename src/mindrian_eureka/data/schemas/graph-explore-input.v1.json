{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.graph-explore-input.v1",
  "title": "Graph relationship exploration input",
  "type": "object",
  "required": ["snapshot"],
  "properties": {
    "snapshot": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "maxItems": 10000, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "labels": {"type": "array", "items": {"type": "string"}}, "name": {"type": "string"}, "text": {"type": "string"}, "attrs": {"type": "object"}}, "additionalProperties": true}},
        "edges": {"type": "array", "maxItems": 50000, "items": {"type": "object", "required": ["s", "t", "type"], "properties": {"s": {"type": "string"}, "t": {"type": "string"}, "type": {"type": "string"}, "created_at": {"type": ["string", "null"]}}, "additionalProperties": true}},
        "meta": {"type": "object"}
      },
      "additionalProperties": false
    },
    "top": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
    "seed": {"type": "integer", "default": 7},
    "attr": {"type": "string", "default": "problem_type"},
    "text_label": {"type": ["string", "null"]},
    "min_common": {"type": "integer", "minimum": 1, "default": 2},
    "null_rounds": {"type": "integer", "minimum": 1, "maximum": 20, "default": 8},
    "focus_node_id": {"type": ["string", "null"]},
    "focus_hops": {"type": "integer", "minimum": 0, "maximum": 5, "default": 2}
  },
  "additionalProperties": false
}
