{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.hsi-baseline-whitespace-output.v1",
  "title": "portfolio.analyze_baseline_whitespace result",
  "type": "object",
  "required": ["schema_version", "capability_id", "capability_version", "status", "scope", "input_fingerprint", "method", "gaps", "limitations"],
  "properties": {
    "schema_version": { "const": "eureka.hsi-baseline-whitespace.v1" },
    "capability_id": { "const": "portfolio.analyze_baseline_whitespace" },
    "capability_version": { "const": "0.1.0" },
    "status": { "const": "completed_room_relative_scan" },
    "scope": {
      "type": "object", "required": ["scope_id", "snapshot_id"],
      "properties": { "scope_id": { "type": ["string", "null"] }, "snapshot_id": { "type": ["string", "null"] } },
      "additionalProperties": false
    },
    "input_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "method": { "type": "object" },
    "gaps": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
