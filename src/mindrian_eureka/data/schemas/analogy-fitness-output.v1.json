      "const": "completed_experimental"
    },
    "scope_id": {"type": ["string", "null"]},
    "snapshot_id": {"type": ["string", "null"]},
    "candidates": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
