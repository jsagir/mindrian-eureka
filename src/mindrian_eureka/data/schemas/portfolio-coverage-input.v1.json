{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eureka.portfolio-coverage-input.v1",
  "title": "portfolio.inventory_taxonomy_coverage input",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "taxonomy_source": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "title": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "category_ids"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 25000
    },
    "taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 5000
    }
  },
  "required": [
    "artifacts",
    "taxonomy"
  ],
  "additionalProperties": false
}
